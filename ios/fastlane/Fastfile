def connect_api_key
  return nil unless ENV["APP_STORE_CONNECT_KEY_ID"] && ENV["APP_STORE_CONNECT_ISSUER_ID"] && ENV["APP_STORE_CONNECT_KEY_CONTENT_BASE64"]

  app_store_connect_api_key(
    key_id: ENV.fetch("APP_STORE_CONNECT_KEY_ID"),
    issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
    key_content: ENV.fetch("APP_STORE_CONNECT_KEY_CONTENT_BASE64"),
    is_key_content_base64: true
  )
end

def prepare_project
  sh("xcodegen generate")
end

def build_release
  build_app(
    project: "Stabilize.xcodeproj",
    scheme: "Stabilize",
    clean: true,
    export_method: "app-store",
    xcargs: "-allowProvisioningUpdates"
  )
end

default_platform(:ios)

platform :ios do
  desc "Build and upload an internal TestFlight build"
  lane :beta do
    prepare_project
    build_release
    upload_to_testflight(
      api_key: connect_api_key,
      skip_waiting_for_build_processing: false,
      distribute_external: false
    )
  end

  desc "Upload metadata and submit the selected build for review"
  lane :release do
    upload_to_app_store(
      api_key: connect_api_key,
      app_identifier: "info.stabilize.app",
      metadata_path: "fastlane/metadata",
      skip_binary_upload: true,
      skip_screenshots: false,
      submit_for_review: true,
      automatic_release: false,
      force: true,
      precheck_include_in_app_purchases: false
    )
  end
end
