def connect_api_key
  app_store_connect_api_key(
    key_id: ENV.fetch("APP_STORE_CONNECT_KEY_ID"),
    issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
    key_content: ENV.fetch("APP_STORE_CONNECT_KEY_CONTENT_BASE64"),
    is_key_content_base64: true
  )
end

def require_xcode_cloud_release!
  return if ENV["STABILIZE_XCODE_CLOUD_RELEASE"] == "1"

  UI.user_error!(
    "This release lane may run only inside the configured Stabilize Xcode Cloud release workflow."
  )
end

default_platform(:ios)

platform :ios do
  desc "Upload Stabilize 1.1 metadata after Xcode Cloud has uploaded a processed build"
  lane :metadata do
    require_xcode_cloud_release!
    upload_to_app_store(
      api_key: connect_api_key,
      app_identifier: "info.stabilize.app",
      app_version: "1.1",
      metadata_path: "fastlane/metadata",
      skip_binary_upload: true,
      skip_screenshots: true,
      submit_for_review: false,
      force: true,
      precheck_include_in_app_purchases: false
    )
  end

  desc "Submit an already-uploaded Xcode Cloud build of Stabilize 1.1 to App Review"
  lane :submit do
    require_xcode_cloud_release!
    build_number = ENV.fetch("XCODE_CLOUD_BUILD_NUMBER")

    upload_to_app_store(
      api_key: connect_api_key,
      app_identifier: "info.stabilize.app",
      app_version: "1.1",
      build_number: build_number,
      metadata_path: "fastlane/metadata",
      skip_binary_upload: true,
      skip_screenshots: true,
      submit_for_review: true,
      automatic_release: false,
      force: true,
      precheck_include_in_app_purchases: false
    )
  end
end
