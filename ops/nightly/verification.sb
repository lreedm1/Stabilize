(version 1)

(allow default)

; Repository code may write only inside a disposable verification root.
(deny file-write*
  (require-not (subpath (param "WRITABLE_ROOT"))))

; Worker tests may use localhost, but no external network is available.
(deny network*)
(allow network-bind (local ip "localhost:*"))
(allow network-inbound (local ip "localhost:*"))
(allow network-outbound (remote ip "localhost:*"))
