{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["outcome", "theme", "targetFile", "changeKind", "evidenceStrength"],
  "properties": {
    "outcome": {
      "type": "string",
      "enum": ["no_change", "proposed_change", "private_review"]
    },
    "theme": {
      "type": "string",
      "enum": ["none", "readability", "spacing", "contrast", "focus_visibility"]
    },
    "targetFile": {
      "type": "string",
      "enum": ["none", "public/product.css", "public/guides.css"]
    },
    "changeKind": {
      "type": "string",
      "enum": ["none", "font_size", "line_height", "spacing", "color_contrast", "focus_outline"]
    },
    "evidenceStrength": {
      "type": "string",
      "enum": ["none", "weak", "conflicting", "single_clear", "repeated"]
    }
  }
}
