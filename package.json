{
  "name": "stabilize",
  "version": "0.1.0",
  "private": true,
  "description": "A minimal, stateless, floor-first AI support website for Cloudflare Workers.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "check": "wrangler types --check --include-runtime false && wrangler deploy --dry-run",
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "test": "node --test",
    "types": "wrangler types --include-runtime false"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "wrangler": "4.118.0"
  }
}
