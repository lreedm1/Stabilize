{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "stabilize",
  "main": "src/domain-router.js",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "keep_vars": true,
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    {
      "pattern": "stabilize.info/*",
      "zone_name": "stabilize.info"
    },
    {
      "pattern": "reedlokken.com/*",
      "zone_name": "reedlokken.com"
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [
      { "name": "SESSIONS", "class_name": "SessionMemory" },
      { "name": "BILLING", "class_name": "BillingAccount" },
      { "name": "FEEDBACK_LIMITS", "class_name": "FeedbackGate" },
      { "name": "FEEDBACK_INBOX", "class_name": "FeedbackInbox" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["SessionMemory"] },
    { "tag": "v2", "new_sqlite_classes": ["BillingAccount"] },
    { "tag": "v3", "new_sqlite_classes": ["FeedbackGate", "FeedbackInbox"] }
  ],
  "vars": {
    "DEMO_MODE": "false",
    "OPENAI_MODEL": "gpt-5.6-sol",
    "OPENAI_REASONING_EFFORT": "max",
    "PUBLIC_ORIGIN": "https://stabilize.info",
    "MODEL_CHOICES": "gpt-5.6-sol|Stabilize default,gpt-5.1|GPT-5.1,gpt-5-mini|GPT-5 mini",
    "PAID_MONTHLY_MESSAGE_LIMIT": "200",
    "STRIPE_MODEL_CHOICE_PRICE_ID": "price_1U01Jp96tfbPOBGIbQNXDlPx",
    "FEEDBACK_REPOSITORY": "lreedm1/Stabilize",
    "FEEDBACK_BRANCH": "feedback-inbox",
    "FEEDBACK_PATH": "feedback"
  },
  "secrets": {
    "required": [
      "OPENAI_API_KEY",
      "GOOGLE_CLIENT_ID",
      "GOOGLE_CLIENT_SECRET",
      "AUTH_SECRET"
    ]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
