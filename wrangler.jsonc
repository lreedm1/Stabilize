{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "stabilize",
  "main": "src/paid-worker.js",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "keep_vars": true,
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/auth/*",
      "/billing/*",
      "/account/*",
      "/",
      "/index.html"
    ]
  },
  "durable_objects": {
    "bindings": [
      { "name": "SESSIONS", "class_name": "SessionMemory" },
      { "name": "BILLING", "class_name": "BillingAccount" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["SessionMemory"] },
    { "tag": "v2", "new_sqlite_classes": ["BillingAccount"] }
  ],
  "vars": {
    "DEMO_MODE": "false",
    "OPENAI_MODEL": "gpt-5.6-sol",
    "OPENAI_REASONING_EFFORT": "medium",
    "PUBLIC_ORIGIN": "https://reedlokken.com",
    "MODEL_CHOICES": "gpt-5.6-sol|Stabilize default,gpt-5.1|GPT-5.1,gpt-5-mini|GPT-5 mini",
    "PAID_MONTHLY_MESSAGE_LIMIT": "200",
    "STRIPE_MODEL_CHOICE_PRICE_ID": "price_1U01Jp96tfbPOBGIbQNXDlPx"
  },
  "secrets": {
    "required": [
      "OPENAI_API_KEY",
      "GOOGLE_CLIENT_ID",
      "GOOGLE_CLIENT_SECRET",
      "AUTH_SECRET"
    ]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
