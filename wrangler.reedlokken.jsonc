{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "reedlokken-to-stabilize-redirect",
  "main": "src/reedlokken-redirect.js",
  "compatibility_date": "2026-08-09",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "reedlokken.com",
      "custom_domain": true
    },
    {
      "pattern": "www.reedlokken.com",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    }
  }
}
